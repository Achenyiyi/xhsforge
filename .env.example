# Database
POSTGRES_DB=xhs_app
POSTGRES_USER=xhs_app
POSTGRES_PASSWORD=xhs_app_password
DATABASE_URL=postgresql://xhs_app:xhs_app_password@localhost:5432/xhs_app?schema=public

# Auth
APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_CODE_PEPPER=change-me-to-another-long-random-secret

# SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_BASE_URL=https://open.feishu.cn
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_REWRITE_TABLE_ID=
NEXT_PUBLIC_FEISHU_DOC_LIBRARY_URL=https://scnfuauc9lis.feishu.cn/base/N199bIGfLaUeHIsKBKfcOMHpnce?table=tblTZ7bQXEHlX6uP&view=vewLQJiq5w

# XHS crawler provider
XHS_API_BASE_URL=https://api.yddm.com
XHS_API_KEY=

# DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-plus

# Jimeng local proxy
JIMENG_API_BASE_URL=http://localhost:5100
JIMENG_SESSION_ID=
JIMENG_MODEL=jimeng-4.6
JIMENG_REQUEST_TIMEOUT_MS=90000

# Request tuning
XHS_REQUEST_TIMEOUT_MS=15000
XHS_RETRY_ATTEMPTS=3
XHS_RETRY_BASE_DELAY_MS=800
SAVE_DRAFT_CONCURRENCY=3
SAVE_DRAFT_RETRY_ATTEMPTS=4
SAVE_DRAFT_RETRY_BASE_DELAY_MS=800
